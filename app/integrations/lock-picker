#!/usr/bin/env python3
"""Persistent native Serpantinum layout picker; never changes authentication."""
import json, os, re, subprocess, sys, tempfile, shutil
from pathlib import Path
from datetime import datetime
HOME=Path.home()
ROOT=HOME/'.config/rice-studio-portable/lock-layouts'
LIVE=HOME/'.local/state/serpantinum/lockscreen/layout.json'
STATE=HOME/'.local/state/rice-studio-portable/lock-picker'
DESCS={'pixel':'Dotted charcoal · white pixel clock · no widgets','original':'Your preserved Serpantinum layout', 'minimal':'Quiet center: clock, username, password', 'portrait':'Avatar above a compact password panel', 'dashboard':'Wide panel with weather, music and system widgets'}
def write(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    fd,tmp=tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd,'w') as f: json.dump(data,f,indent=2); f.write('\n')
    os.replace(tmp,path)
def valid(data):
    if data.get('version')!=3 or not any(e.get('itype')=='password' for e in data.get('items',[])):
        raise ValueError('Layout must use native version 3 and contain a password field.')
    return data
def profiles(): return sorted(p.stem for p in ROOT.glob('*.json'))
def preview(name):
    data=valid(json.loads((ROOT/(name+'.json')).read_text()))
    print('\033[38;2;214;195;161mLOCK SCREEN / '+name.upper()+'\033[0m\n')
    print(DESCS.get(name,'Your saved layout')+'\n')
    grid=[[' ']*48 for _ in range(16)]
    # Schematic preview of the resting screen and the revealed unlock panel.
    p=data['panel']; w=p['w']; h=p['h']
    print(('Resting screen: dotted charcoal with upper-left pixel clock' if name=='pixel' else 'Resting screen: clock over your wallpaper')+'\nUnlock panel schematic:\n┌'+'─'*48+'┐')
    for e in data['items']:
        x=min(45,max(0,int(e['ix']/w*42))); y=min(15,max(0,int(e['iy']/h*14)))
        label={'password':'[ ••• password ]','avatar':'( avatar )'}.get(e['itype'],e['itype'].replace('widget:',''))
        for i,c in enumerate(label[:48-x]): grid[y][x+i]=c
    for row in grid: print('│'+''.join(row)+'│')
    print('└'+'─'*48+'┘\nLayout illustration · uses your current desktop colors\n\nEnter: save selection    Esc: cancel\nSuper+L: lock when you are ready')
def main():
    args=sys.argv[1:]
    if not (HOME/'.local/share/serpantinum/src/quickshell/Shell.qml').is_file():
        raise ValueError('The lock layout picker requires Serpantinum.')
    if LIVE.is_file() and not (ROOT/'original.json').exists():
        write(ROOT/'original.json',valid(json.loads(LIVE.read_text())))
    if args and args[0]=='--preview': preview(args[1]); return
    if args and args[0]=='--list': print('\n'.join(profiles())); return
    if args and args[0]=='save':
        name=args[1] if len(args)>1 else ''
        if not re.fullmatch('[a-z][a-z0-9-]{0,30}',name) or name in DESCS: raise ValueError('Use a new lowercase name, e.g. lock-picker save my-layout')
        dest=ROOT/(name+'.json')
        if dest.exists(): raise ValueError('That saved layout already exists; choose a new name.')
        write(dest,valid(json.loads(LIVE.read_text())))
        print('Saved '+name); return
    if args and args[0]=='edit': subprocess.run(['serpantinum','launch','lock-redactor','open'],check=True); return
    if not args:
        if not sys.stdin.isatty():
            os.execvp('kitty',['kitty','--class','lock-picker','--title','Lock screen picker',str(Path(__file__).resolve())])
        rows=[n+'\t'+DESCS.get(n,'Saved custom layout') for n in profiles()]
        result=subprocess.run(['fzf','--delimiter','\t','--with-nth','1,2','--prompt','Lock screen › ','--header','Enter saves · Esc cancels · selection does not lock','--preview',str(Path(__file__).resolve())+' --preview {1}','--preview-window','right:60%:wrap','--color','hl:#d6c3a1,pointer:#d6c3a1,border:#73867a'],input='\n'.join(rows),text=True,stdout=subprocess.PIPE)
        if result.returncode: return
        name=result.stdout.split('\t')[0].strip()
    else: name=args[0]
    if name not in profiles(): raise ValueError('Unknown layout; use lock-picker --list')
    data=valid(json.loads((ROOT/(name+'.json')).read_text()))
    if LIVE.exists():
        STATE.mkdir(parents=True,exist_ok=True)
        shutil.copy2(LIVE,STATE/('before-'+datetime.now().strftime('%Y%m%d-%H%M%S-%f')+'.json'))
    write(LIVE,data)
    write(STATE/'selection.json',{'selected':name})
    print('Selected '+name+'. Saved for the next lock. Super+L locks your screen.')
if __name__=='__main__':
    try: main()
    except (ValueError,OSError,subprocess.CalledProcessError) as e: print(str(e),file=sys.stderr); sys.exit(1)

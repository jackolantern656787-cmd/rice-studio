{
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "spacing": 4,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "ext/workspaces",
    "hyprland/window",
    "mpris",
    "tray"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "network",
    "cpu",
    "memory",
    "wireplumber#sink",
    "wireplumber#source"
  ],
  "mpris": {
    "format": "{dynamic}",
    "format-paused": "<i>{dynamic}</i>",
    "max-length": 30,
    "cursor": 68
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8,
    "cursor": 68
  },
  "cpu": {
    "format": "cpu: {usage}%",
    "interval": 10,
    "on-click": "kitty --class bar-monitor -e btop",
    "on-click-right": "kitty --class bar-gpu -e nvtop",
    "tooltip": true,
    "cursor": 68
  },
  "memory": {
    "interval": 10,
    "format": "mem: {}%",
    "max-length": 10,
    "on-click": "kitty --class bar-monitor -e btop",
    "on-click-right": "kitty --class bar-gpu -e nvtop",
    "tooltip": true,
    "cursor": 68
  },
  "wireplumber#sink": {
    "format": "vol: {volume}%",
    "format-muted": "vol: mut",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle volume",
    "on-click-right": "@STUDIO_APP@/themes/bars/sunny/volume output mute",
    "on-scroll-up": "@STUDIO_APP@/themes/bars/sunny/volume output up",
    "on-scroll-down": "@STUDIO_APP@/themes/bars/sunny/volume output down",
    "cursor": 68
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "mic: {volume}%",
    "format-muted": "mic: mut",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle volume",
    "on-click-right": "@STUDIO_APP@/themes/bars/sunny/volume input mute",
    "on-scroll-up": "@STUDIO_APP@/themes/bars/sunny/volume input up",
    "on-scroll-down": "@STUDIO_APP@/themes/bars/sunny/volume input down",
    "cursor": 68
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "inhi",
      "deactivated": "idle"
    },
    "timeout": 30,
    "tooltip": false,
    "cursor": 68
  },
  "network": {
    "interval": 2,
    "format": "{ifname}",
    "format-wifi": "wifi",
    "format-ethernet": "eth",
    "format-disconnected": "discon",
    "tooltip-format": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\nDown Speed: {bandwidthDownBits}\nUp Speed: {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "cursor": 68
  },
  "clock": {
    "format": "{:%a, %b %d, %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "interval": 10,
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "cursor": 68
  },
  "hyprland/window": {
    "max-length": 30,
    "separate-outputs": true,
    "cursor": 68
  },
  "name": "sunny-managed",
  "reload_style_on_change": true,
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": true,
    "all-outputs": true,
    "ignore-hidden": false,
    "cursor": 68
  }
}

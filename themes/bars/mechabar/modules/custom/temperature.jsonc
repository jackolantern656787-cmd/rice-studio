{
  "custom/temperature": {
    "exec": "@STUDIO_APP@/themes/bars/mechabar/scripts/actions.py temperature",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "min-length": 9,
    "max-length": 9,
    "on-click": "kitty --class mechabar-monitor --title \"System monitor\" -e btop",
    "on-click-right": "kitty --class mechabar-monitor --title \"GPU monitor\" -e nvtop",
    "cursor": 68
  }
}

{
  "clock#time": {
    "format": "{:%H:%M}",
    "min-length": 5,
    "max-length": 5,
    "tooltip-format": "{:%A, %d %B %Y}\nClick: calendar",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "cursor": 68
  },
  "clock#date": {
    "format": "󰸗 {:%m/%d}",
    "min-length": 8,
    "max-length": 8,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "months": "<span alpha='100%'>{}</span>",
        "days": "<span alpha='85%'>{}</span>",
        "weekdays": "<span alpha='60%'><i>{}</i></span>",
        "today": "<span alpha='100%'><u>{}</u></span>"
      }
    },
    "tooltip-format": "{calendar}",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "cursor": 68
  }
}

{
  "temperature": {
    "interval": 10,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "󱃃",
      "󰔏",
      "󱃂"
    ],
    "critical-threshold": 90,
    "format-critical": "󰀦 {temperatureC}°C",
    "min-length": 9,
    "max-length": 9,
    "tooltip-format": "In Fahrenheit: {temperatureF}°F",
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
    "cursor": 68
  }
}

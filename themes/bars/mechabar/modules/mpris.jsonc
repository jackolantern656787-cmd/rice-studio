{
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "player-icons": {
      "default": "󰐊"
    },
    "format-paused": "{status_icon} {title} - {artist}",
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 30,
    "tooltip-format": "Playing: {title} — {artist}\nLeft: play/pause • middle: previous • right: next",
    "tooltip-format-paused": "Paused: {title} — {artist}\nLeft: play/pause • middle: previous • right: next",
    "cursor": 68
  }
}

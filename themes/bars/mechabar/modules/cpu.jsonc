{
  "cpu": {
    "interval": 10,
    "format": "󰍛 {usage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format-warning": "󰀨 {usage}%",
    "format-critical": "󰀨 {usage}%",
    "min-length": 8,
    "max-length": 8,
    "tooltip": true,
    "on-click": "kitty --class mechabar-monitor --title \"System monitor\" -e btop",
    "on-click-right": "kitty --class mechabar-monitor --title \"GPU monitor\" -e nvtop",
    "tooltip-format": "CPU usage: {usage}%\nClick: system monitor • right-click: GPU monitor",
    "cursor": 68
  }
}

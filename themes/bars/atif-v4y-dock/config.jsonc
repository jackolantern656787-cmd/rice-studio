{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 35,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 2,
  "modules-left": [
    "custom/omarchy",
    "custom/active_window"
  ],
  "modules-center": [
    "group/center3",
    "ext/workspaces",
    "group/center2"
  ],
  "modules-right": [
    "group/right1"
  ],
  "group/center2": {
    "orientation": "inherit",
    "modules": [
      "clock",
      "idle_inhibitor",
      "custom/notifications"
    ]
  },
  "group/center3": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "custom/separator#blank",
      "mpris"
    ]
  },
  "group/right1": {
    "orientation": "inherit",
    "modules": [
      "tray",
      "custom/separator#blank",
      "custom/separator#dot",
      "custom/separator#blank",
      "custom/mode",
      "pulseaudio",
      "bluetooth",
      "network"
    ]
  },
  "custom/mode": {
    "format": "Dock",
    "on-click": "@STUDIO_APP@/commands/bar-switch atif-mode",
    "tooltip-format": "Switch between bar and dock layout",
    "cursor": 68
  },
  "custom/active_window": {
    "exec": "@STUDIO_APP@/themes/bars/atif-v4y/window.sh",
    "return-type": "json",
    "markup": true,
    "cursor": 68
  },
  "custom/omarchy": {
    "format": "<span size='11500'>\uf51b</span>",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle launcher",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum settings",
    "tooltip-format": "Launcher \u2022 right-click: settings",
    "cursor": 68
  },
  "cpu": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": [
      "\udb82\ude9e",
      "\udb82\ude9f",
      "\udb82\udea0",
      "\udb82\udea1",
      "\udb82\udea2",
      "\udb82\udea3",
      "\udb82\udea4",
      "\udb82\udea5"
    ],
    "on-click": "kitty --class atif-monitor -e btop",
    "cursor": 68
  },
  "memory": {
    "interval": 2,
    "format": "{icon} ",
    "format-icons": [
      "\udb82\ude9e",
      "\udb82\ude9f",
      "\udb82\udea0",
      "\udb82\udea1",
      "\udb82\udea2",
      "\udb82\udea3",
      "\udb82\udea4",
      "\udb82\udea5"
    ],
    "on-click": "kitty --class atif-monitor -e btop",
    "cursor": 68
  },
  "clock": {
    "format": " {:%I:%M %p \u2022 %a, %d/%m}     ",
    "format-alt": "{:%A, %d %B %Y}   ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "cursor": 68
  },
  "network": {
    "format-icons": [
      "\udb82\udd2f",
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25",
      "\udb82\udd28"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "<span size='11500'>\udb80\udf18</span>",
    "format-disconnected": "<span size='11500'>\udb82\udd2e</span>",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "cursor": 68
  },
  "bluetooth": {
    "format": "<span size='11500'>\udb80\udcaf</span>",
    "format-disabled": "<span size='11500'>\udb80\udcb2</span>",
    "format-connected": "<span size='11500'>\uf293</span>",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg open network bluetooth",
    "cursor": 68
  },
  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle volume",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 2,
    "format-muted": "\ueee8 ",
    "format-icons": {
      "default": [
        "\uf026 ",
        "\uf027 ",
        "\uf028 "
      ]
    },
    "max-volume": 100,
    "cursor": 68
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "cursor": 68
  },
  "custom/separator#blank": {
    "format": " ",
    "interval": "once",
    "tooltip": false,
    "cursor": 68
  },
  "custom/separator#dot": {
    "format": "\uf444 ",
    "interval": "once",
    "tooltip": false,
    "cursor": 68
  },
  "name": "atif-managed",
  "ext/workspaces": {
    "format": "\uf444",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-name": true,
    "cursor": 68
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\udb80\udd76",
      "deactivated": "\udb83\udfaa"
    },
    "tooltip-format-activated": "Keep awake: on",
    "tooltip-format-deactivated": "Keep awake: off",
    "cursor": 68
  },
  "custom/notifications": {
    "format": "\udb80\udc9a",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle notifications",
    "tooltip-format": "Notifications",
    "cursor": 68
  },
  "mpris": {
    "format": "\uf001 {title}",
    "max-length": 25,
    "tooltip": true,
    "cursor": 68
  }
}

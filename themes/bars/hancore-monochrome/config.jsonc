{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 27,
  "margin-top": 2,
  "modules-left": [
    "custom/omarchy",
    "ext/workspaces",
    "idle_inhibitor",
    "group/tray-expander",
    "mpris"
  ],
  "modules-center": [
    "clock",
    "custom/notifications"
  ],
  "modules-right": [
    "network",
    "pulseaudio#output",
    "pulseaudio#input",
    "memory",
    "cpu"
  ],
  "custom/omarchy": {
    "format": "\uf303",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle launcher",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum settings",
    "tooltip-format": "Launcher \u2022 right-click: settings",
    "cursor": 68
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\udb81\udeca",
      "deactivated": "\udb83\udfab"
    },
    "cursor": 68
  },
  "cpu": {
    "interval": 10,
    "format": "\uf2db  {usage}%",
    "on-click": "kitty --class hancore-monitor -e btop",
    "cursor": 68
  },
  "memory": {
    "interval": 2,
    "format": "\ue266  {used:0.1f}G",
    "on-click": "kitty --class hancore-monitor -e btop",
    "cursor": 68
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%H:%M %d/%m/%Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#dddddd'><b>{}</b></span>",
        "weekdays": "<span color='#aaaaaa'><b>{}</b></span>",
        "today": "<span color='#ffffff'><b>{}</b></span>"
      }
    },
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle calendar",
    "cursor": 68
  },
  "network": {
    "format-icons": [
      "\udb82\udd2f",
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25",
      "\udb82\udd28"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "\udb80\ude00",
    "format-disconnected": "\udb82\udd2e",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "cursor": 68
  },
  "bluetooth": {
    "format": "\uf294",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\udb80\udcb1",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg open network bluetooth",
    "cursor": 68
  },
  "pulseaudio#input": {
    "format-source": "\uf130",
    "format-source-muted": "\uf131 ",
    "format": "{format_source}",
    "tooltip-format": "{format_source} {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle volume",
    "on-click-right": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume input mute",
    "on-scroll-up": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume input up",
    "on-scroll-down": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume input down",
    "cursor": 68
  },
  "pulseaudio#output": {
    "format": "{icon}",
    "tooltip-format": "{icon}  {volume}%",
    "format-muted": "\uf026 off",
    "format-icons": {
      "default": [
        "\uf025"
      ]
    },
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle volume",
    "on-click-right": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume output mute",
    "on-scroll-up": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume output up",
    "on-scroll-down": "@STUDIO_APP@/themes/bars/hancore-monochrome/volume output down",
    "cursor": 68
  },
  "mpris": {
    "format": "\udb80\udece  {artist} - {title}",
    "format-paused": "<i><span color='grey'>{status_icon} {artist}</span></i>",
    "tooltip-format": "{album}",
    "max-length": 35,
    "player-icons": {
      "default": "\u23f8",
      "mpv": "\uf001"
    },
    "status-icons": {
      "paused": "\udb80\uded0 "
    },
    "cursor": 68
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray",
      "bluetooth"
    ]
  },
  "custom/expand-icon": {
    "format": "\uf08b ",
    "tooltip": false,
    "cursor": 68
  },
  "tray": {
    "icon-size": 11,
    "spacing": 5,
    "cursor": 68,
    "show-passive-items": true
  },
  "name": "hancore-managed",
  "layer": "top",
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": true,
    "all-outputs": true,
    "cursor": 68
  },
  "custom/notifications": {
    "format": "\udb80\udc9a",
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle notifications",
    "tooltip-format": "Notifications",
    "cursor": 68
  }
}

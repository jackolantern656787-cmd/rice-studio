{
  "network": {
    "interval": 10,
    "format": "\udb82\udd28",
    "format-wifi": "{icon}",
    "format-icons": [
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25",
      "\udb82\udd28"
    ],
    "format-disconnected": "\udb82\udd2f",
    "format-disabled": "\udb82\udd2e",
    "format-ethernet": "\udb80\ude00",
    "min-length": 2,
    "max-length": 2,
    "on-click": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "on-click-right": "@STUDIO_APP@/commands/serpantinum msg toggle network",
    "tooltip-format": "Gateway: {gwaddr}",
    "tooltip-format-wifi": "  Network: {essid}\n  IP Addr: {ipaddr}/{cidr}\n Strength: {signalStrength}%\nFrequency: {frequency} GHz",
    "tooltip-format-disconnected": "Wi-Fi Disconnected",
    "tooltip-format-disabled": "Wi-Fi Off",
    "tooltip-format-ethernet": "Interface: {ifname}",
    "cursor": 60
  }
}
